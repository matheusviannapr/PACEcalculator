{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aurum",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "port": 8501
    },
    {
      "name": "vistoria-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8124",
        "--bind",
        "127.0.0.1",
        "--directory",
        "vistoria/dist"
      ],
      "port": 8124
    }
  ]
}
